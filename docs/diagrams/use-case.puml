@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Visitor
actor Customer
actor Administrator
actor Organizer
actor "Frankfurter Exchange Rate API" as Frankfurter
actor RabbitMQ

rectangle "A.1 Ticketing SPA" as A1 {
usecase "Pregled informacija\no trci" as UCView
usecase "Kupovina karte" as UCPurchase
usecase "Korišćenje promo koda" as UCPromo
usecase "Izmena karte" as UCModify
usecase "Otkazivanje karte" as UCCancel
usecase "Kupovina paddock\npropusnice" as UCPaddock
usecase "Izmena konfiguracije\ntrke" as UCAdmin
usecase "Izračunavanje konačne\ncene" as UCPrice
usecase "Objavljivanje potvrđenog\ndogađaja za izveštavanje" as UCPublish
}

rectangle "A.2 Organizer Reporting Portal" as A2 {
usecase "Pregled karata po\ndanu takmičenja" as UCDayReport
usecase "Pregled kupovina\npo datumu" as UCPurchaseReport
usecase "Filtriranje kupovina\npo početnom datumu" as UCFilter
usecase "Pregled ukupnog broja\npaddock opcija" as UCPaddockReport
usecase "Osvežavanje izveštaja" as UCRefresh
}

Visitor --> UCView
Customer --> UCView
Customer --> UCPurchase
Customer --> UCPromo
Customer --> UCModify
Customer --> UCCancel
Customer --> UCPaddock
Administrator --> UCAdmin
Organizer --> UCDayReport
Organizer --> UCPurchaseReport
Organizer --> UCFilter
Organizer --> UCPaddockReport
Organizer --> UCRefresh

UCPromo .> UCPurchase : <<extend>>
UCPurchase .> UCPrice : <<include>>
UCModify .> UCPrice : <<include>>
UCPaddock .> UCPrice : <<include>>
UCPurchase .> UCPublish : <<include>>
UCModify .> UCPublish : <<include>>
UCCancel .> UCPublish : <<include>>
UCPaddock .> UCPublish : <<include>>
UCFilter .> UCPurchaseReport : <<include>>

Frankfurter --> UCPrice
RabbitMQ --> UCPublish
@enduml
